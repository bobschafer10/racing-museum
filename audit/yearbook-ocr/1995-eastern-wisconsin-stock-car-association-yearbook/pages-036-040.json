[{"document_type":"yearbook","document_slug":"1995-eastern-wisconsin-stock-car-association-yearbook","document_title":"1995 Eastern Wisconsin Stock Car Association Yearbook","publication_year":1995,"page_label":"036.jpg","page_number":36,"storage_path":"programs/1995-eastern-wisconsin-stock-car-association-yearbook/036.jpg","mime_type":"image/jpeg","status":"complete","ocr_engine":"PaddleOCR","ocr_model":"PP-OCRv5_mobile_det + en_PP-OCRv5_mobile_rec","ocr_text":"=== COLUMN 1 ===\nLENT2\nTURNER HALL\n892-6651\n#99 Bob Otte\nAGE: 37\nOCCUPATION: Self Employed\nCITY: Plymouth\nOWNER: Bob Otte\nENGINE: Chevy\nBODY: Monte Carlo SS\nSPONSORS: Dragon Slayer Unlimited, Sheboygan Falls; Ed Cain\nConstruction, Plymouth; Re-Max Universal Realty, Inc., Butch Cain,\nPlymouth; Al Rittenhouse Drywall, Plymouth; Bob's Auto & Racing,\nPlymouth; Battery Operated Music Service, Steve Schmidt & Mike\nPhiefer, Waldo.\nPIT CREW: Crew Chief Lonny Koene, Fabricator Paul Herman, Wrench\nBob Godfrey, Crew Don Otte, Sheri Schmidt, D.J. Crimmins, Doug\nBlackburn, Jeff Wulf Sr., Jon Forsberg, Bob Goetsch.\nEXPERIENCE: Not Enough.\nINFO ABOUT CAR: M&R ChaSSiS.\nFAMILY: Robin 17, Chrissy 14, Bobbi-Sue 13.\nHOBBIES: Boating.\nYou know its racing\nseason when\nDedicated to all the race driver wives and girlfriends\n— Adapted by Sue McKarns\nThe only room that gets cleaned is the camper.\nYou start worrying about the race day forecast every Tuesday.\nThe tire bill is bigger than your house payment.\nYou clean out your purse and find six ticket stubs, one tire\npressure gauge, two rolls of film and dirt.\nYour weekend meals are hot dogs and popcorn.\nYou haven't been to your family reunion for years because\nit's the first Sunday of August.\n\n=== COLUMN 2 ===\nThank you\nto Drews\nPhotography\nof West Bend\nfor supplying\nthe pictures\nfor the\n1995 program.\nThe race car gets waxed more often than your floor.\nYou tell your neighbor you'll be able to come to their yard\nparty on Saturday . .. if it rains.\nYou know the number of the parts store by heart, but have to\nlook up your grandmother's number in the phone book.\nYou celebrate your anniversary at the races.\nThe district sales manager you work for calls you into his office\nto ask you if you can get him a deal on a rebuilt carburetor.\nA leisure dinner is eating \"in\" at McDonald's rather than the\ndrive-thru.\nThe family photo album is now a box with rubber banded groups\nof pictures in it.\n\"As soon as I get the car running, I'll fix that leaky faucet\"\nmeans: call the plumber.\nThe races on your driveway include 3 divisions: big wheels,\nbikes and remote control cars.\n- 40 -","ocr_json":{"space":"normalized","source":"prepared_image","image_sha256":"320dbd343dc02066dd9ab59d005e78f9f3bd4b1b11bfe4f029be2be3dcd60cd4","lines":[{"t":"Thank you","x":0.642494,"y":0.049316,"w":0.239186,"h":0.047852,"s":0.9998},{"t":"to Drews","x":0.660941,"y":0.098633,"w":0.195929,"h":0.037109,"s":0.9972},{"t":"LENT2","x":0.208651,"y":0.142578,"w":0.026081,"h":0.012207,"s":0.9485},{"t":"Photography","x":0.617048,"y":0.141602,"w":0.285623,"h":0.04834,"s":1.0},{"t":"TURNER HALL","x":0.204835,"y":0.148926,"w":0.057252,"h":0.019531,"s":0.9459},{"t":"892-6651","x":0.204835,"y":0.159668,"w":0.043257,"h":0.018555,"s":0.9022},{"t":"of West Bend","x":0.614504,"y":0.187988,"w":0.292621,"h":0.046875,"s":0.9659},{"t":"for supplying","x":0.605598,"y":0.23291,"w":0.302163,"h":0.050293,"s":0.9999},{"t":"#99 Bob Otte","x":0.03626,"y":0.27832,"w":0.125318,"h":0.016602,"s":0.9996},{"t":"the pictures","x":0.629771,"y":0.281738,"w":0.262087,"h":0.043457,"s":0.9995},{"t":"AGE: 37","x":0.035623,"y":0.29541,"w":0.05598,"h":0.013672,"s":0.971},{"t":"OCCUPATION: Self Employed","x":0.03626,"y":0.306641,"w":0.188295,"h":0.013184,"s":0.9796},{"t":"CITY: Plymouth","x":0.038168,"y":0.319336,"w":0.096692,"h":0.010254,"s":0.9694},{"t":"OWNER: Bob Otte","x":0.037532,"y":0.32959,"w":0.113868,"h":0.010254,"s":0.9792},{"t":"for the","x":0.673028,"y":0.327
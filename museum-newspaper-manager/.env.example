SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media

NEWSPAPERS_ROOT_FOLDER=newspapers
MAX_NEWSPAPER_FOLDERS=25

# Optional. Defaults shown below.
MANIFEST_NEWSPAPERS=../public/data/newspapers-manifest.json
NEWSPAPER_BATCH_FOLDER=newspaper-upload-batch
NEWSPAPER_OCR_ENABLED=true
NEWSPAPER_OCR_MAX_PAGES=3
